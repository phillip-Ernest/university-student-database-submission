Table departments {
  department_id int [pk, increment]
  department_name varchar(100) [not null, unique]
}

Table programs {
  program_id int [pk, increment]
  department_id int [not null]
  program_name varchar(150) [not null]
  degree_level varchar(50) [not null]
}

Table students {
  student_id int [pk, increment]
  program_id int [not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email varchar(150) [not null, unique]
  date_of_birth date
  phone varchar(30)
  enrollment_status varchar(30) [not null]
}

Table instructors {
  instructor_id int [pk, increment]
  department_id int [not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email varchar(150) [not null, unique]
}

Table courses {
  course_id int [pk, increment]
  department_id int [not null]
  course_code varchar(30) [not null, unique]
  course_name varchar(150) [not null]
  credit_hours int [not null]
}

Table course_prerequisites {
  course_id int [not null]
  prerequisite_course_id int [not null]

  indexes {
    (course_id, prerequisite_course_id) [pk]
  }
}

Table course_offerings {
  offering_id int [pk, increment]
  course_id int [not null]
  instructor_id int [not null]
  semester varchar(30) [not null]
  academic_year int [not null]
}

Table enrollments {
  enrollment_id int [pk, increment]
  student_id int [not null]
  offering_id int [not null]
  enrolled_at timestamp
  enrollment_status varchar(30) [not null]

  indexes {
    (student_id, offering_id) [unique]
  }
}

Table grades {
  grade_id int [pk, increment]
  enrollment_id int [not null, unique]
  letter_grade varchar(5)
  grade_points decimal(4,2)
  graded_at timestamp
}

Ref: programs.department_id > departments.department_id
Ref: students.program_id > programs.program_id
Ref: instructors.department_id > departments.department_id
Ref: courses.department_id > departments.department_id
Ref: course_prerequisites.course_id > courses.course_id
Ref: course_prerequisites.prerequisite_course_id > courses.course_id
Ref: course_offerings.course_id > courses.course_id
Ref: course_offerings.instructor_id > instructors.instructor_id
Ref: enrollments.student_id > students.student_id
Ref: enrollments.offering_id > course_offerings.offering_id
Ref: grades.enrollment_id - enrollments.enrollment_id
